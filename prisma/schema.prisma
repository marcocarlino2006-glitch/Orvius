generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Business {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  phone                String?
  ownerPhone           String?
  ownerEmail           String?
  timezone             String   @default("America/New_York")
  hoursJson            String   @default("{}")
  servicesJson         String   @default("[]")
  greeting             String?
  vapiAssistantId      String?
  vapiPhoneNumber      String?
  twilioPhone          String?
  isActive             Boolean  @default(true)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  billingStatus        String   @default("pilot")
  billingPlan          String?
  /** When the free design-partner window ends. After this, subscribe or lock. */
  pilotEndsAt          DateTime?
  /** Last time owner copied/exported weekly economics proof. */
  lastWeeklyProofAt    DateTime?
  /** Founder phone cert checklist JSON — boolean[] matching Settings scenarios. */
  founderCertJson      String?
  lineVerifiedAt       DateTime?
  /** When set, owner SMS alerts are suppressed until START / cleared. */
  ownerSmsOptOutAt     DateTime?
  /** Shop avg ticket in cents — used for estimated pipeline value. */
  avgTicketCents       Int?
  /** Baseline: missed/overflow calls per week before Orvius (owner-reported). */
  baselineMissedCallsPerWeek Int?
  /** Baseline: jobs booked per week before Orvius (owner-reported). */
  baselineJobsPerWeek  Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  calls            Call[]
  leads            Lead[]
  customers        Customer[]
  jobs             Job[]
  technicians      Technician[]
  estimates        Estimate[]
  invoices         Invoice[]
  payments         Payment[]
  copilotActions   CopilotAction[]
  ownerNotifications OwnerNotification[]
  webhookEvents      WebhookEvent[]
  smsOptOuts         SmsOptOut[]
}

/** Phone numbers that opted out of SMS on a shop line (STOP). */
model SmsOptOut {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phone        String
  phoneNormalized String
  source       String   @default("inbound-sms")
  createdAt    DateTime @default(now())
  clearedAt    DateTime?

  @@unique([businessId, phoneNormalized])
  @@index([businessId, clearedAt])
}

model Customer {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String?
  phone             String
  phoneNormalized   String
  email             String?
  address           String?
  notes             String?
  interactionCount  Int      @default(1)
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  calls Call[]
  leads Lead[]
  jobs  Job[]

  @@unique([businessId, phoneNormalized])
  @@index([businessId, lastSeenAt])
}

model Call {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vapiCallId   String?   @unique
  callerPhone  String?
  direction    String    @default("inbound")
  status       String    @default("in-progress")
  durationSec  Int?
  summary      String?
  transcript   String?
  recordingUrl String?
  booked           Boolean   @default(false)
  ownerNotifiedAt  DateTime?
  /** VAPI analysis.successEvaluation — NumericScale 1–10 when configured. */
  successEvaluation String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  lead Lead?
}

model Lead {
  id          String    @id @default(cuid())
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  callId      String?   @unique
  call        Call?     @relation(fields: [callId], references: [id], onDelete: SetNull)
  externalId  String?
  name        String?
  phone       String?
  email       String?
  serviceType String?
  urgency     String?
  address     String?
  notes       String?
  status      String    @default("new")
  source      String    @default("call")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  job Job?

  @@unique([businessId, externalId])
  @@index([businessId, createdAt])
}

model Job {
  id            String      @id @default(cuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId        String?     @unique
  lead          Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  technicianId  String?
  technician    Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  title         String
  serviceType   String?
  urgency       String?
  address       String?
  notes         String?
  status        String      @default("scheduled")
  scheduledAt   DateTime?
  confirmedAt   DateTime?
  dispatchedAt  DateTime?
  onSiteAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  estimate Estimate?

  @@index([businessId, scheduledAt])
  @@index([businessId, status])
  @@index([technicianId, scheduledAt])
}

model Technician {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  role       String   @default("tech")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  jobs Job[]

  @@index([businessId, isActive])
}

/** Money ring v1 — draft estimate linked to a job. */
model Estimate {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId         String?   @unique
  job           Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  leadId        String?
  amountCents   Int
  status        String    @default("draft")
  lineItemsJson String    @default("[]")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  invoice       Invoice?

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

/** Thin Money stub — status tracking only, no payment rails yet. */
model Invoice {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  estimateId  String?   @unique
  estimate    Estimate? @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  jobId       String?
  amountCents Int
  status      String    @default("draft")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]

  @@index([businessId, status])
}

model Payment {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountCents Int
  status      String   @default("recorded")
  method      String?
  createdAt   DateTime @default(now())

  @@index([businessId, createdAt])
}

/** Approve-then-execute Copilot actions. */
model CopilotAction {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  action     String
  paramsJson String
  preview    String
  status     String    @default("proposed")
  resultJson String?
  createdAt  DateTime  @default(now())
  executedAt DateTime?

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

model WaitlistEntry {
  id           String   @id @default(cuid())
  email        String   @unique
  businessName String?
  phone        String?
  trade        String?
  city         String?
  plan         String   @default("pilot")
  /** Pipeline: new | contacted | demoed | onboarded | live | closed */
  status       String   @default("new")
  notes        String?
  lastContactedAt DateTime?
  nextActionAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OwnerNotification {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leadId       String?
  channel      String
  dedupeKey    String
  status       String
  error        String?
  businessName String?
  message      String?
  ownerPhone   String?
  ownerEmail   String?
  attempts     Int       @default(0)
  nextRetryAt  DateTime?
  deliveryId   String?
  deliveryStatus String?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([businessId, dedupeKey, channel])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([status, nextRetryAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  source      String
  externalId  String
  eventType   String
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  status      String
  payloadJson String?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([source, externalId, eventType])
  @@index([businessId, createdAt])
  @@index([source, createdAt])
}
