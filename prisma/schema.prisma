generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Business {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  /** production | demo | test — demo and test data never render in a production workspace. */
  environment          String   @default("production")
  /** Orvius sends confirmations and assigns clear-cut jobs itself; the owner can turn this off. */
  autopilot            Boolean  @default(true)
  /** "book": callers are offered open times and qualified calls are booked. "alert": nothing is booked; every request waits for the owner. */
  bookingMode          String   @default("book")
  /** Setup progress and choices while the shop is still in test mode: { sandbox, step, goal, testedAt, liveAt }. */
  setupJson            String   @default("{}")
  /** Texting callers who did not book: "off", "ask" (owner taps send) or "auto". */
  followUpMode         String   @default("ask")
  /** Bumped when the owner resets their calendar feed link; old links stop working. */
  calendarFeedVersion  Int      @default(1)
  phone                String?
  ownerPhone           String?
  ownerEmail           String?
  timezone             String   @default("America/New_York")
  /** Primary trade — HVAC | Plumbing | Electrical. Drives prompts and taxonomy. */
  trade                String?
  /** Shop street address for intake and service-area context. */
  address              String?
  hoursJson            String   @default("{}")
  servicesJson         String   @default("[]")
  greeting             String?
  /** Callers who ask for a person are connected here. Null means transfers are off and they get a callback. */
  /** Last time the owner loaded Command on any device — anchors "since you looked". */
  ownerLastSeenAt      DateTime?
  /** ElevenLabs voice for this shop's receptionist; null uses the default. */
  voiceId              String?
  transferPhone        String?
  vapiAssistantId      String?
  vapiPhoneNumber      String?
  twilioPhone          String?
  isActive             Boolean  @default(true)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  billingStatus        String   @default("pilot")
  billingPlan          String?
  /**
   * Connect: the shop's own Stripe account. Customer card money settles to the
   * shop directly and Orvius only ever takes an application fee, which is what
   * keeps us out of being a money transmitter.
   *
   * `chargesEnabled` is Stripe's verdict after identity verification and is the
   * only field allowed to gate card collection. An account can exist, and can
   * have submitted every detail, while still not being cleared to charge.
   */
  stripeConnectAccountId        String?  @unique
  stripeConnectChargesEnabled   Boolean  @default(false)
  stripeConnectPayoutsEnabled   Boolean  @default(false)
  stripeConnectDetailsSubmitted Boolean  @default(false)
  stripeConnectUpdatedAt        DateTime?
  /** The owner switched on pay-over-time (Affirm, Klarna) on their pay links. */
  financingEnabled              Boolean  @default(false)
  /** Pay-over-time methods Stripe has made active on the shop's account, comma-separated. */
  financingMethods              String?
  /** Deposit asked for at booking. Null amount or false means deposits off. */
  depositEnabled                Boolean  @default(false)
  depositAmountCents            Int?
  /** When card payments first went live and deposits were switched on by default. Set once. */
  paymentsDefaultedAt           DateTime?
  /** When the free design-partner window ends. After this, subscribe or lock. */
  pilotEndsAt          DateTime?
  /** Last time owner copied/exported weekly economics proof. */
  lastWeeklyProofAt    DateTime?
  /** Last automatic Monday results email. */
  weeklyReportSentAt DateTime?
  /** Last weekly value text to the owner's phone. */
  weeklyTextSentAt   DateTime?
  /// Owner's private iCal address; busy times there are never offered to callers.
  busyCalendarUrl      String?
  /** Where a finished customer is asked to leave a review (Google, Yelp, Facebook…). */
  reviewUrl            String?
  /** Text each finished customer the review link once, the day of the visit. */
  reviewRequestsOn     Boolean  @default(true)
  /** Public booking page at /b/[slug]; off until the owner shares it. */
  bookingPageOn        Boolean  @default(false)
  /** Chat bubble for the shop's own website (/embed.js); visitors are answered by text. */
  webChatOn            Boolean  @default(false)
  busyCalendarJson     String?
  busyCalendarSyncedAt DateTime?
  busyCalendarError    String?
  /** Founder phone cert checklist JSON — boolean[] matching Settings scenarios. */
  founderCertJson      String?
  /** Owner confirmed missed/busy/after-hours forward to Orvius line. */
  overflowForwardConfirmedAt DateTime?
  /**
   * Capture path the owner is running: forward overflow, or publish Orvius
   * as the main shop number. Survives reload so the confirm stamp matches UI.
   */
  captureMode          String?  @default("forward")
  /** Carrier guide last used when captureMode is forward. */
  forwardCarrier       String?
  /** missed | all | after_hours | main — what the owner chose to send to Orvius. */
  forwardCoverage      String?
  /** When forward/publish steps were texted to the owner (overflow proof trail). */
  forwardGuideSentAt   DateTime?
  /**
   * Overflow capture proved — line verified + owner confirmed after guide.
   * Stronger than the self-attest checkbox alone.
   */
  overflowProvedAt     DateTime?
  lineVerifiedAt       DateTime?
  /** ZIP allowlist JSON string[] — empty means not configured (no hard reject). */
  serviceZipsJson      String   @default("[]")
  /** When set, owner SMS alerts are suppressed until START / cleared. */
  ownerSmsOptOutAt     DateTime?
  /** Shop avg ticket in cents — used for estimated pipeline value. */
  avgTicketCents       Int?
  /** Baseline: missed/overflow calls per week before Orvius (owner-reported). */
  baselineMissedCallsPerWeek Int?
  /** Baseline: jobs booked per week before Orvius (owner-reported). */
  baselineJobsPerWeek  Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  calls            Call[]
  leads            Lead[]
  customers        Customer[]
  jobs             Job[]
  jobberConnection JobberConnection?
  quickbooksConnection QuickBooksConnection?
  technicians      Technician[]
  estimates        Estimate[]
  invoices         Invoice[]
  payments         Payment[]
  deposits         Deposit[]
  copilotActions   CopilotAction[]
  ownerNotifications OwnerNotification[]
  pushSubscriptions  PushSubscription[]
  webhookEvents      WebhookEvent[]
  smsOptOuts         SmsOptOut[]
  takeovers          Takeover[]
  outboundSms        OutboundSms[]
  texting            ShopTexting?
  portRequest        PortRequest?
  forwardTests       ForwardTest[]
  /// First touch before signup (ref, utm, referring site, landing page), as JSON.
  acquisitionJson    String?
  /// Orvius Network: passes jobs it can't take to nearby shops in its trade and receives theirs.
  networkOn          Boolean  @default(false)
  /// First three digits of the shop's ZIP; the network matches shops within the same region.
  networkZip3        String?
  /// The shop whose link this one signed up from.
  referredById       String?
  referralsMade      Referral[] @relation("ReferralReferrer")
  referredBy         Referral?  @relation("ReferralReferred")
  messages           Message[]
  servicePlans       ServicePlan[]
  planMembers        PlanMember[]
  auditEvents        AuditEvent[]
  memberships        Membership[]
  jobPhotos          JobPhoto[]
  jobSignatures      JobSignature[]
  galleryCalls       GalleryCall[]
  jobNotes           JobNote[]
  jobLineItems       JobLineItem[]
  priceBookItems     PriceBookItem[]
  /** Last calendar month ("2026-09") whose call overage was invoiced; one charge per month, ever. */
  overageBilledPeriod String?
  /** When Stripe first reported the subscription past due; the grace period runs from here. */
  pastDueSince       DateTime?
  /** When the subscription ended; the line is suspended now and released after the retention window. */
  canceledAt         DateTime?
  /** When a lapsed shop's number was given back to Twilio. */
  lineReleasedAt     DateTime?
  /// Owner corrections the receptionist follows on every call: [{ id, text, createdAt, callId? }].
  receptionistRulesJson String @default("[]")
  /** When the line stopped answering for non-payment; cleared when it answers again. */
  lineSuspendedAt    DateTime?

  @@index([ownerEmail])
  @@index([twilioPhone])
  @@index([vapiPhoneNumber])
  @@index([vapiAssistantId])
  @@index([stripeCustomerId])
  @@index([networkOn, trade, networkZip3])
}

/** Phone numbers that opted out of SMS on a shop line (STOP). */
/// Every text Orvius sends goes out from one shared sender, so a reply cannot be
/// routed by the number it was sent to. This is how a reply finds its shop.
/// Carrier registration (A2P 10DLC) so a shop's customer and tech texts come
/// from its own number. Until `status` is "approved" they use the shared sender.
/// One shop sending another. The referrer is credited a month of its plan
/// when the referred shop's first paid invoice clears.
model Referral {
  id          String    @id @default(cuid())
  referrerId  String
  referrer    Business  @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId  String    @unique
  referred    Business  @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: Cascade)
  /// pending → crediting → credited, or void when the referrer had stopped paying.
  status      String    @default("pending")
  creditCents Int?
  creditedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([referrerId, status])
}

/// A shop asking to move its existing number onto Orvius. Orvius files it with
/// the carriers; the owner fills one form instead of emailing a bill and a PIN.
/// One "does my number reach Orvius?" test: Orvius dials the business number
/// from its own line and watches for that call to arrive back at the line.
model ForwardTest {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessNumber String
  coverage       String
  outboundSid    String?
  /// calling | reached | not_reached | answered_elsewhere | busy | failed
  state          String    @default("calling")
  title          String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([businessId, startedAt])
}

model PortRequest {
  id             String    @id @default(cuid())
  businessId     String    @unique
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  number         String
  carrier        String
  accountName    String
  accountNumber  String
  /// Port-out PIN, sealed with secret-box; null when sealing isn't configured.
  pinSealed      String?
  serviceAddress String
  authorizedName String
  /// received → filed → scheduled → done, or failed.
  status         String    @default("received")
  portDate       DateTime?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
}

model ShopTexting {
  id                  String    @id @default(cuid())
  businessId          String    @unique
  business            Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// submitted → profile_review → brand_review → campaign_review → approved, or failed.
  status              String    @default("submitted")
  /// The legal details the carriers require, as the owner entered them.
  detailsJson         String
  customerProfileSid  String?
  trustProductSid     String?
  brandSid            String?
  messagingServiceSid String?
  campaignSid         String?
  failureReason       String?
  submittedAt         DateTime  @default(now())
  approvedAt          DateTime?
  lastCheckedAt       DateTime?
  updatedAt           DateTime  @updatedAt

  @@index([status, lastCheckedAt])
}

model OutboundSms {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  toNormalized String
  audience     String
  sid          String?
  /** Kept for texts to technicians, the proof on a job that they were told. Customer texts live in Message. */
  body           String?
  deliveryStatus String?
  /** The job a technician text is about, so its history shows only its own texts. */
  jobId          String?
  createdAt    DateTime @default(now())

  @@index([toNormalized, createdAt])
  @@index([businessId, createdAt])
  @@index([sid])
  @@index([jobId])
}

/** A membership or maintenance plan customers pay for monthly or yearly. */
model ServicePlan {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  priceCents    Int
  /** month | year */
  interval      String
  /** Included visits a year; drives the "your visit is due" text. 0 means none. */
  visitsPerYear Int      @default(0)
  perks         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members PlanMember[]

  @@index([businessId, isActive])
}

model PlanMember {
  id                   String      @id @default(cuid())
  businessId           String
  business             Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId               String
  plan                 ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  customerId           String?
  name                 String?
  phone                String
  phoneNormalized      String
  email                String?
  /** pending | active | past_due | canceled */
  status               String      @default("pending")
  stripeSubscriptionId String?     @unique
  stripeCustomerId     String?
  startedAt            DateTime?
  currentPeriodEnd     DateTime?
  canceledAt           DateTime?
  nextVisitDueAt       DateTime?
  visitReminderSentAt  DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([businessId, status])
  @@index([businessId, phoneNormalized])
  @@index([status, nextVisitDueAt])
}

/** Every customer text in and out, so the owner reads and answers one thread per phone. */
model Message {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phoneNormalized String
  /** in | out */
  direction       String
  /** customer | orvius | owner */
  author          String
  body            String
  sid             String?
  /** Carrier receipt for an outbound text: sent | delivered | undelivered | failed. */
  deliveryStatus  String?
  /** Photos on an inbound text: JSON [{ url, type }], Twilio media URLs fetched only through the authed proxy. */
  mediaJson       String?
  /** Set when the owner has read an inbound text. */
  readAt          DateTime?
  createdAt       DateTime @default(now())

  @@unique([businessId, sid])
  @@index([businessId, phoneNormalized, createdAt])
  @@index([businessId, createdAt])
}

model SmsOptOut {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phone        String
  phoneNormalized String
  source       String   @default("inbound-sms")
  createdAt    DateTime @default(now())
  clearedAt    DateTime?

  @@unique([businessId, phoneNormalized])
  @@index([businessId, clearedAt])
}

/// A person took this conversation over: Orvius stops automated texts to the phone until released.
model Takeover {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phoneNormalized String
  leadId          String?
  /// Sign-in email of the person who took over.
  takenBy         String
  reason          String?
  createdAt       DateTime  @default(now())
  releasedAt      DateTime?
  releasedBy      String?

  @@unique([businessId, phoneNormalized])
  @@index([businessId, releasedAt])
}

model Customer {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String?
  phone             String
  phoneNormalized   String
  /** The same person in the shop's Jobber, once Orvius has matched or created them. */
  jobberClientId    String?
  /** The same person in the shop's QuickBooks, once Orvius has matched or created them. */
  quickbooksCustomerId String?
  email             String?
  address           String?
  /** Extra places this customer is served, JSON [{label, line}]. The primary address stays on `address`. */
  addressesJson     String   @default("[]")
  /** Equipment on file, JSON [{name, brand, model, notes}]. */
  equipmentJson     String   @default("[]")
  notes             String?
  interactionCount  Int      @default(1)
  /** Last "we miss you" text; one per customer every 90 days. */
  winBackSentAt     DateTime?
  /** Written yes to promotional texts (booking-page box or texting JOIN). Win-back only goes to these. STOP clears it. */
  marketingOptInAt     DateTime?
  marketingOptInSource String?
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  calls Call[]
  leads Lead[]
  jobs  Job[]

  @@unique([businessId, phoneNormalized])
  @@index([businessId, lastSeenAt])
}

model Call {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vapiCallId   String?   @unique
  callerPhone  String?
  /** "web_demo" for the website's talk-in-the-browser demo; null for phone calls. */
  channel      String?
  direction    String    @default("inbound")
  status       String    @default("in-progress")
  durationSec  Int?
  summary      String?
  transcript   String?
  recordingUrl String?
  booked           Boolean   @default(false)
  ownerNotifiedAt  DateTime?
  /** VAPI analysis.successEvaluation — NumericScale 1–10 when configured. */
  successEvaluation String?
  /** Appointment the receptionist offered and the caller took during the call; booking uses it. */
  heldSlotAt          DateTime?
  heldSlotDurationMin Int?
  /** When this call's hold was claimed; the earlier claim keeps a contested time. */
  heldClaimedAt       DateTime?
  /** Database-assigned order of hold writes; commit order and sequence order always agree. */
  heldSeq Int?
  /** "reschedule" when the held time is a new time for a visit the caller already has, never a new job. */
  heldIntent String?
  /// The caller said yes, on the call, to being passed to a nearby Orvius Network shop.
  networkConsentAt    DateTime?
  /** When the returning-caller note was handed to the live receptionist (once per call). */
  callerContextSentAt DateTime?
  /** Caller's wait for a reply on this call, from Vapi's turn timing (lib/call-latency.ts). */
  replyP50Ms  Int?
  replyP90Ms  Int?
  /** {turns, stages: {endpointing, transcriber, model, voice}} medians in ms. */
  latencyJson String?
  /** Vapi's reported charge for this call in millionths of a dollar; the phone leg is not in it (lib/call-cost.ts). */
  costMicros Int?
  /** {stt, llm, tts, vapi, transport} in micros. */
  costJson   String?
  /** Transcript and recording deleted here and at Vapi after the retention period (lib/retention.ts). */
  contentPurgedAt DateTime?
  /** Vapi's endedReason, e.g. "assistant-forwarded-call" when the caller was transferred to a person. */
  endedReason String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  lead Lead?

  @@index([businessId, createdAt])
  @@index([businessId, updatedAt])
  @@index([contentPurgedAt, createdAt])
  @@index([businessId, heldSlotAt])
}

model Lead {
  id          String    @id @default(cuid())
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  callId      String?   @unique
  call        Call?     @relation(fields: [callId], references: [id], onDelete: SetNull)
  externalId  String?
  name        String?
  phone       String?
  email       String?
  serviceType String?
  urgency     String?
  address     String?
  notes       String?
  status      String    @default("new")
  source      String    @default("call")
  /**
   * Canonical demand taxonomy code (src/lib/job-taxonomy.ts). Derived, never
   * typed by an owner. Free-text serviceType cannot be counted across shops;
   * this can, and a call answered without it is a call whose category is gone.
   */
  categoryCode String?
  /** ZIP parsed from address — the unit local price benchmarks group on. */
  postalCode   String?
  /** First time the shop worked this lead, for speed-to-lead vs. win rate. */
  firstContactedAt DateTime?
  /** The one follow-up text to an unbooked caller; stamped before sending so it can never go twice. */
  followUpSentAt    DateTime?
  followUpRepliedAt DateTime?
  /** When the lead reached a terminal status (booked, lost, spam). */
  closedAt         DateTime?
  /** The teammate responsible for this request (owner or member email); null means the shop owner. */
  assigneeEmail    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  job      Job?
  deposits Deposit[]
  estimates Estimate[]

  @@unique([businessId, externalId])
  @@index([businessId, createdAt])
  @@index([businessId, categoryCode])
  @@index([businessId, postalCode])
  @@index([businessId, updatedAt])
  @@index([businessId, status, createdAt])
}

model Job {
  id            String      @id @default(cuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId        String?     @unique
  lead          Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  technicianId  String?
  technician    Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  title         String
  serviceType   String?
  urgency       String?
  address       String?
  notes         String?
  /** Carried from the lead so completed work joins the same taxonomy. */
  categoryCode  String?
  postalCode    String?
  status        String      @default("scheduled")
  scheduledAt   DateTime?
  confirmedAt   DateTime?
  /** Public token for customer confirm link (/c/[token]). */
  customerConfirmToken String? @unique
  /** Stamped only after Twilio accepts the initial confirmation SMS. */
  customerConfirmSentAt DateTime?
  /** One retry only; stamped only after Twilio accepts it. */
  customerConfirmReminderSentAt DateTime?
  /** Held while a confirmation text is being sent, so two runs can't both send it. */
  customerConfirmClaimAt DateTime?
  /** Twilio sid of the latest confirmation text, matched against the carrier's delivery receipt. */
  customerConfirmSid String?
  /** The carrier rejected the confirmation text; the owner was asked to call instead. */
  customerConfirmFailedAt DateTime?
  /** When the customer confirmed the proposed window. */
  customerConfirmedAt DateTime?
  dispatchedAt  DateTime?
  onSiteAt      DateTime?
  completedAt   DateTime?
  /** The customer was texted the review link for this visit; claimed before the send. */
  reviewRequestedAt DateTime?
  /** Structured field outcome — the label future intelligence learns from. */
  resolutionCode String?
  /** Short technician evidence, never generated or inferred. */
  resolutionSummary String?
  /** Actual total reported at completion; separate from estimate/invoice. */
  finalAmountCents Int?
  outcomeCapturedAt DateTime?
  /** The field checklist for this visit: the template it started from and what the technician ticked or read. */
  checklistJson String?
  /** Magic-link token for tech field page (/t/[token]). */
  techToken     String?     @unique
  /** Free-text ETA from tech (e.g. "25 min"). */
  etaText       String?
  /** Appointment length from the trade playbook; null means the shop default. */
  durationMin   Int?
  /** The teammate responsible for this job (owner or member email); null means the technician, then the owner. */
  assigneeEmail String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  estimate Estimate?
  deposits Deposit[]
  invoices Invoice[]
  signature JobSignature?
  photos   JobPhoto[]
  fieldNotes JobNote[]
  lineItems JobLineItem[]

  @@index([businessId, scheduledAt])
  @@index([businessId, status])
  @@index([technicianId, scheduledAt])
  @@index([businessId, categoryCode])
  @@index([customerConfirmSid])
  @@index([businessId, updatedAt])
}

model Technician {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  role       String   @default("tech")
  isActive   Boolean  @default(true)
  /** Playbook skill keys (e.g. ["cooling","heating"]). Empty means generalist. */
  skillsJson String   @default("[]")
  /** The technician's own app link (/tech/[token]). Sending a new link retires the old one. */
  appToken   String?   @unique
  appTokenAt DateTime?
  /** This technician's own working hours, same shape as Business.hoursJson. Empty means the shop's hours. */
  hoursJson  String   @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  jobs    Job[]
  timeOff TechnicianTimeOff[]

  /*
    One name, one person. ensureCrew read the table and then created the owner
    row, so two requests arriving together — which is exactly what the dispatch
    page does, fetching the board and the crew in parallel — each saw an empty
    table and each seeded a row. Two of the four fixture shops carry three
    identical owner records, and the board draws the same person three times.

    It also settles a thing the add-technician form never handled: a shop could
    enter "Ray" twice and then have no way to tell the two Rays apart when
    assigning a job.
  */
  @@unique([businessId, name])
  @@index([businessId, isActive])
}

/** A photo taken on a job. Resized on the phone before upload, so a row stays well under a megabyte. */
/** A website visitor's place in line for the in-browser demo, and the call it became. */
model DemoTicket {
  id         String    @id @default(cuid())
  /** Salted hash of the visitor's IP: enough to hold one place per visitor, never the address. */
  ipHash     String
  /** waiting | granted | live | done */
  status     String    @default("waiting")
  lastSeenAt DateTime  @default(now())
  grantedAt  DateTime?
  startedAt  DateTime?
  endedAt    DateTime?
  vapiCallId String?   @unique
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
}

/** The customer's sign-off on the work and total, drawn on the technician's phone. */
model JobSignature {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId        String   @unique
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  signerName   String
  /** PNG drawn on the phone; sniffed and size-capped before it is stored. */
  png          Bytes
  sizeBytes    Int
  /** The total the customer saw when signing, and the exact words they agreed to. */
  agreedCents  Int?
  statement    String
  technicianId String?
  signedAt     DateTime @default(now())

  @@index([businessId, signedAt])
}

model JobPhoto {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /** "before" | "after" | "other" */
  kind         String   @default("other")
  mime         String
  bytes        Bytes
  sizeBytes    Int
  width        Int?
  height       Int?
  caption      String?
  /** Who took it: a technician's name, or a teammate's email. */
  takenBy      String?
  technicianId String?
  createdAt    DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([businessId, createdAt])
}

/** A note on a job from the field or the office. */
model JobNote {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /** "technician" | "person" */
  authorKind   String
  authorName   String
  body         String
  createdAt    DateTime @default(now())

  @@index([jobId, createdAt])
}

/** One line of work on a job. A job with lines is billed their total. */
model JobLineItem {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId           String
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  priceBookItemId String?
  name            String
  /** "service" | "labor" | "part" */
  kind            String   @default("service")
  quantity        Float    @default(1)
  unitCents       Int
  position        Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([jobId, position])
}

/** The shop's saved services, labor and parts with prices. */
model PriceBookItem {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  /** "service" | "labor" | "part" */
  kind        String   @default("service")
  unitCents   Int
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId, isActive])
}

/** Money ring v1 — draft estimate linked to a job. */
model Estimate {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId         String?   @unique
  job           Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  leadId        String?
  lead          Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  amountCents   Int
  status        String    @default("draft")
  lineItemsJson String    @default("[]")
  /** Good / Better / Best: the customer picks one, and its price becomes amountCents. */
  optionsJson   String    @default("[]")
  chosenOption  String?
  notes         String?
  /** Public magic-link token for customer view/accept/pay (/e/[token]). */
  publicToken   String?   @unique
  sentAt        DateTime?
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  invoice       Invoice?

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

/** What the customer owes for finished work; paid by card on the shop's own Stripe account or recorded by hand. */
model Invoice {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  estimateId  String?   @unique
  estimate    Estimate? @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  jobId       String?
  job         Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  amountCents Int
  status      String    @default("draft")
  /** Public magic-link token for the customer pay page (/i/[token]). */
  publicToken String?   @unique
  sentAt      DateTime?
  paidAt      DateTime?
  /** Direct-charge Checkout session on the connected account; unique so a replay cannot pay twice. */
  stripeSessionId     String? @unique
  /** What Orvius earned here, stamped at fulfilment and never recomputed. */
  applicationFeeCents Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]

  @@index([businessId, status])
  @@index([jobId])
}

model Payment {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountCents Int
  status      String   @default("recorded")
  method      String?
  createdAt   DateTime @default(now())

  @@index([businessId, createdAt])
}

/**
 * Money collected when the job is booked, on the shop's own Stripe account.
 *
 * Deliberately not an Estimate or an Invoice. Both of those describe work that
 * has already been scoped and priced, and a deposit is taken before either
 * exists — at 2am, on the call, which is the only moment the customer is
 * motivated. It hangs off the lead rather than the job because a lead is the
 * one thing every answered call produces; a job may never be booked, and on
 * the Line plan routinely is not.
 */
model Deposit {
  id                    String    @id @default(cuid())
  businessId            String
  business              Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leadId                String?
  lead                  Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  jobId                 String?
  job                   Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  amountCents           Int
  /** pending | paid | canceled | refunded | failed */
  status                String    @default("pending")
  /** Public magic-link token for the customer pay page (/d/[token]). */
  publicToken           String?   @unique
  /**
   * Checkout session id, which lives on the connected account rather than the
   * platform. Unique so a replayed webhook cannot record a second payment.
   */
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?
  /** What Orvius earned here, stamped at fulfilment and never recomputed. */
  applicationFeeCents   Int?
  sentAt                DateTime?
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

/** Approve-then-execute Copilot actions. */
model CopilotAction {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  action     String
  paramsJson String
  preview    String
  status     String    @default("proposed")
  resultJson String?
  createdAt  DateTime  @default(now())
  executedAt DateTime?

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

model WaitlistEntry {
  id           String   @id @default(cuid())
  email        String   @unique
  businessName String?
  phone        String?
  trade        String?
  city         String?
  plan         String   @default("pilot")
  /** Pipeline: new | contacted | demoed | onboarded | live | closed */
  status       String   @default("new")
  notes        String?
  lastContactedAt DateTime?
  nextActionAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OwnerNotification {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leadId       String?
  channel      String
  dedupeKey    String
  status       String
  error        String?
  businessName String?
  message      String?
  ownerPhone   String?
  ownerEmail   String?
  attempts     Int       @default(0)
  nextRetryAt  DateTime?
  deliveryId   String?
  deliveryStatus String?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([businessId, dedupeKey, channel])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([status, nextRetryAt])
  @@index([businessId, processedAt])
  @@index([deliveryId])
  @@index([createdAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  source      String
  externalId  String
  eventType   String
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  status      String
  payloadJson String?
  error       String?
  /// Sweep retries of a call report that failed to finish.
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@unique([source, externalId, eventType])
  @@index([businessId, createdAt])
  @@index([source, createdAt])
  @@index([source, eventType, status, createdAt])
  @@index([createdAt])
}

/// Single-use sign-in link. Only the SHA-256 of the token is stored, so a leaked
/// database row cannot be replayed as a login.
/// Email + password sign-in. verifiedAt stays null until the owner proves the
/// address (Google, an emailed link, or a reset); an unverified login is
/// dropped the moment someone else proves it.
model PasswordLogin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  verifiedAt   DateTime?
  failedCount  Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model LoginToken {
  id         String    @id @default(cuid())
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

/**
 * One decision in the operating loop — what Orvius (or the owner) decided,
 * about which record, and why. idempotencyKey makes webhook retries and
 * replays write each decision once.
 */
model AuditEvent {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /** call | lead | customer | job | technician | notification | copilot | shop */
  entityType     String
  entityId       String
  /** Stable machine code, e.g. lead.captured, technician.assigned. */
  action         String
  /** orvius | owner | teammate | system */
  actor          String   @default("orvius")
  /** Sign-in email of the person who acted, when a person did. */
  actorEmail     String?
  summary        String
  detailJson     String?
  callId         String?
  leadId         String?
  customerId     String?
  jobId          String?
  idempotencyKey String?
  createdAt      DateTime @default(now())

  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt])
  @@index([businessId, entityType, entityId])
  @@index([businessId, action, createdAt])
  @@index([leadId])
  @@index([jobId])
  @@index([customerId])
}

/** A browser or installed app the owner turned on push alerts for. */
model PushSubscription {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  endpoint    String    @unique
  p256dh      String
  auth        String
  userAgent   String?
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([businessId])
}

/// One paid provisioning run (a shop's number and assistant), leased so two
/// requests can't both buy, and remembered so a retry reuses what was bought.
model ProvisionAttempt {
  key             String   @id
  /// Written into the Twilio number's friendly name, so a purchase whose
  /// response was lost can still be found before buying again.
  tag             String   @unique
  status          String
  leaseUntil      DateTime
  attempts        Int      @default(1)
  phoneNumber     String?
  vapiAssistantId String?
  businessId      String?
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Rate-limit counters shared by every server instance.
/// Paid model calls made on a shop's behalf outside the phone line (Ask), per UTC day. Drives the daily cap and the cost model.
model ModelUsage {
  businessId String
  day        String
  kind       String
  calls      Int    @default(0)
  micros     Int    @default(0)

  @@id([businessId, day, kind])
  @@index([day])
}

model RateLimitBucket {
  key       String @id
  count     Int
  resetAtMs BigInt

  @@index([resetAtMs])
}

/// Someone other than the owner with access to a shop. The owner is Business.ownerEmail.
model Membership {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Lowercased sign-in email.
  email      String
  /// manager | dispatcher
  role       String   @default("dispatcher")
  invitedBy  String?
  lastSeenAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([businessId, email])
  @@index([email])
}

/// "Hear your shop" preview: before paying, the owner calls the demo line from
/// their own phone and it answers as their shop. Never tied to a Business, so a
/// preview call can never land in a real shop's records.
/** A stretch a technician is not working: vacation, sick day, training. No booking lands on them inside it. */
model TechnicianTimeOff {
  id           String     @id @default(cuid())
  businessId   String
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  startsAt     DateTime
  endsAt       DateTime
  reason       String?
  createdAt    DateTime   @default(now())

  @@index([technicianId, endsAt])
  @@index([businessId, endsAt])
}

model ShopPreview {
  id             String    @id @default(cuid())
  token          String    @unique
  shopName       String
  trade          String    @default("HVAC")
  serviceArea    String?
  servicesJson   String    @default("[]")
  hoursJson      String    @default("{}")
  ownerPhone     String
  ownerPhoneNormalized String
  ip             String?
  callsUsed      Int       @default(0)
  maxCalls       Int       @default(2)
  expiresAt      DateTime
  lastVapiCallId String?   @unique
  lastCallAt     DateTime?
  lastSummary    String?
  lastCaptureJson String?
  alertSentAt    DateTime?
  /// The last preview call line by line, kept so the owner can share it as a Call Replay.
  transcriptJson String?
  createdAt      DateTime  @default(now())

  @@index([ownerPhoneNormalized, expiresAt])
  @@index([createdAt])
}


/** A shop's Jobber account. Tokens are sealed with ORVIUS_TOKEN_KEY (secret-box.ts), never stored in the clear. */
model JobberConnection {
  id              String    @id @default(cuid())
  businessId      String    @unique
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountId       String
  accountName     String?
  accessTokenEnc  String?
  refreshTokenEnc String?
  accessExpiresAt DateTime?
  /** Held while one worker refreshes: Jobber rotates refresh tokens, so two refreshes at once would disconnect the shop. */
  refreshClaimAt  DateTime?
  /** active | disconnected | reconnect (Jobber refused our tokens) */
  status          String    @default("active")
  lastError       String?
  connectedAt     DateTime  @default(now())
  disconnectedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([accountId])
}

/** A shop's QuickBooks Online company. Tokens are sealed with ORVIUS_TOKEN_KEY, like Jobber's. */
model QuickBooksConnection {
  id              String    @id @default(cuid())
  businessId      String    @unique
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  realmId         String
  companyName     String?
  accessTokenEnc  String?
  refreshTokenEnc String?
  accessExpiresAt DateTime?
  /** Held while one worker refreshes: Intuit rotates refresh tokens, so two refreshes at once would disconnect the shop. */
  refreshClaimAt  DateTime?
  /** The service item every receipt line is booked against, found or created once. */
  itemId          String?
  /** active | disconnected | reconnect (Intuit refused our tokens) */
  status          String    @default("active")
  lastError       String?
  connectedAt     DateTime  @default(now())
  disconnectedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([realmId])
}

/** One payment collected in Orvius on its way into QuickBooks as a sales receipt. At most one per payment. */
model QuickBooksSync {
  id            String    @id @default(cuid())
  businessId    String
  /** invoice | deposit */
  sourceType    String
  sourceId      String
  amountCents   Int
  /** pending | done | skipped | failed */
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  claimedAt     DateTime?
  qbCustomerId  String?
  qbReceiptId   String?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([sourceType, sourceId])
  @@index([status, nextAttemptAt])
  @@index([businessId, createdAt])
}

/** One lead on its way into the shop's Jobber as a request. At most one per lead, and never sent twice. */
model JobberSync {
  id              String    @id @default(cuid())
  businessId      String
  leadId          String    @unique
  /** pending | done | skipped | failed | check (sent, reply lost: look in Jobber before resending) */
  status          String    @default("pending")
  attempts        Int       @default(0)
  nextAttemptAt   DateTime  @default(now())
  claimedAt       DateTime?
  requestSentAt   DateTime?
  jobberClientId  String?
  jobberRequestId String?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([businessId, createdAt])
}

/// A preview call the owner chose to share. A copy, so a later preview call
/// never changes a link that is already posted.
model CallReplay {
  id          String   @id
  previewId   String
  shopName    String
  trade       String
  turnsJson   String
  captureJson String?
  views       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([previewId])
}

/// A job one shop could not take, passed to a nearby shop in the same trade.
/// The caller is always asked first; nothing is shared until they say yes.
model NetworkHandoff {
  id                    String    @id @default(cuid())
  fromBusinessId        String
  leadId                String    @unique
  callerPhone           String
  callerPhoneNormalized String
  trade                 String
  zip3                  String
  /// asking → offered → taken; or declined (caller said no), none (no shop free), expired.
  status                String    @default("asking")
  offeredToJson         String    @default("[]")
  toBusinessId          String?
  toLeadId              String?
  askedAt               DateTime  @default(now())
  offeredAt             DateTime?
  takenAt               DateTime?
  /// The passing shop's share of the network fee: crediting → credited, or void when it could not be paid.
  creditStatus          String?
  creditCents           Int?
  creditedAt            DateTime?

  @@index([callerPhoneNormalized, status])
  @@index([toLeadId])
  @@index([status, offeredAt])
  @@index([toBusinessId])
}

/// When each scheduled sweep last ran, so a missed schedule is noticed and made up.
model CronRun {
  name        String    @id
  lastRunAt   DateTime?
  lastClaimAt DateTime?
}

/// A real customer call a shop shares on the public gallery. Only the masked
/// transcript is copied here; it is listed after the owner confirms the caller
/// agreed and an Orvius admin reviews it.
model GalleryCall {
  id              String    @id
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  callId          String    @unique
  shopName        String
  trade           String
  turnsJson       String
  captureJson     String?
  /** pending | listed | removed | withdrawn */
  status          String    @default("pending")
  callerConsentAt DateTime
  sharedByEmail   String
  reviewedAt      DateTime?
  views           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([businessId])
}
