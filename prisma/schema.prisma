generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Business {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  phone                String?
  ownerPhone           String?
  ownerEmail           String?
  timezone             String   @default("America/New_York")
  hoursJson            String   @default("{}")
  servicesJson         String   @default("[]")
  greeting             String?
  vapiAssistantId      String?
  vapiPhoneNumber      String?
  twilioPhone          String?
  isActive             Boolean  @default(true)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  billingStatus        String   @default("pilot")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  calls     Call[]
  leads     Lead[]
  customers Customer[]
  jobs      Job[]
}

model Customer {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String?
  phone             String
  phoneNormalized   String
  email             String?
  address           String?
  notes             String?
  interactionCount  Int      @default(1)
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  calls Call[]
  leads Lead[]
  jobs  Job[]

  @@unique([businessId, phoneNormalized])
  @@index([businessId, lastSeenAt])
}

model Call {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vapiCallId   String?   @unique
  callerPhone  String?
  direction    String    @default("inbound")
  status       String    @default("in-progress")
  durationSec  Int?
  summary      String?
  transcript   String?
  recordingUrl String?
  booked       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lead Lead?
}

model Lead {
  id          String    @id @default(cuid())
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  callId      String?   @unique
  call        Call?     @relation(fields: [callId], references: [id], onDelete: SetNull)
  name        String?
  phone       String?
  email       String?
  serviceType String?
  urgency     String?
  address     String?
  notes       String?
  status      String    @default("new")
  source      String    @default("call")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  job Job?
}

model Job {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId       String?   @unique
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  title        String
  serviceType  String?
  urgency      String?
  address      String?
  notes        String?
  status       String    @default("scheduled")
  scheduledAt  DateTime?
  confirmedAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([businessId, scheduledAt])
  @@index([businessId, status])
}

model WaitlistEntry {
  id           String   @id @default(cuid())
  email        String   @unique
  businessName String?
  phone        String?
  trade        String?
  city         String?
  plan         String   @default("pilot")
  status       String   @default("new")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
