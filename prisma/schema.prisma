generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Business {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  phone                String?
  ownerPhone           String?
  ownerEmail           String?
  timezone             String   @default("America/New_York")
  hoursJson            String   @default("{}")
  servicesJson         String   @default("[]")
  greeting             String?
  vapiAssistantId      String?
  vapiPhoneNumber      String?
  twilioPhone          String?
  isActive             Boolean  @default(true)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  billingStatus        String   @default("pilot")
  billingPlan          String?
  lineVerifiedAt       DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  calls            Call[]
  leads            Lead[]
  customers        Customer[]
  jobs             Job[]
  technicians      Technician[]
  ownerNotifications OwnerNotification[]
  webhookEvents      WebhookEvent[]
}

model Customer {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String?
  phone             String
  phoneNormalized   String
  email             String?
  address           String?
  notes             String?
  interactionCount  Int      @default(1)
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  calls Call[]
  leads Lead[]
  jobs  Job[]

  @@unique([businessId, phoneNormalized])
  @@index([businessId, lastSeenAt])
}

model Call {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vapiCallId   String?   @unique
  callerPhone  String?
  direction    String    @default("inbound")
  status       String    @default("in-progress")
  durationSec  Int?
  summary      String?
  transcript   String?
  recordingUrl String?
  booked           Boolean   @default(false)
  ownerNotifiedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  lead Lead?
}

model Lead {
  id          String    @id @default(cuid())
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  callId      String?   @unique
  call        Call?     @relation(fields: [callId], references: [id], onDelete: SetNull)
  externalId  String?
  name        String?
  phone       String?
  email       String?
  serviceType String?
  urgency     String?
  address     String?
  notes       String?
  status      String    @default("new")
  source      String    @default("call")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  job Job?

  @@unique([businessId, externalId])
  @@index([businessId, createdAt])
}

model Job {
  id            String      @id @default(cuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId        String?     @unique
  lead          Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  technicianId  String?
  technician    Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  title         String
  serviceType   String?
  urgency       String?
  address       String?
  notes         String?
  status        String      @default("scheduled")
  scheduledAt   DateTime?
  confirmedAt   DateTime?
  dispatchedAt  DateTime?
  onSiteAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([businessId, scheduledAt])
  @@index([businessId, status])
  @@index([technicianId, scheduledAt])
}

model Technician {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  role       String   @default("tech")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  jobs Job[]

  @@index([businessId, isActive])
}

model WaitlistEntry {
  id           String   @id @default(cuid())
  email        String   @unique
  businessName String?
  phone        String?
  trade        String?
  city         String?
  plan         String   @default("pilot")
  status       String   @default("new")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OwnerNotification {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leadId       String?
  channel      String
  dedupeKey    String
  status       String
  error        String?
  businessName String?
  message      String?
  ownerPhone   String?
  ownerEmail   String?
  attempts     Int       @default(0)
  nextRetryAt  DateTime?
  deliveryId   String?
  deliveryStatus String?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([businessId, dedupeKey, channel])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([status, nextRetryAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  source      String
  externalId  String
  eventType   String
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  status      String
  payloadJson String?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([source, externalId, eventType])
  @@index([businessId, createdAt])
  @@index([source, createdAt])
}
