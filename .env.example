DATABASE_URL="file:./dev.db"

# Domain strategy
ORVIUS_PRIMARY_DOMAIN=orvius.im
ORVIUS_MARKETING_DOMAIN=orvius.im
ORVIUS_APP_DOMAIN=app.orvius.im
ORVIUS_API_DOMAIN=api.orvius.im
ORVIUS_DEPLOY_TARGET=vercel

# App — dashboard + Stripe (NOT the api webhook host)
NEXT_PUBLIC_APP_URL=https://app.orvius.im

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Vapi
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# Optional: auto-onboard defaults
ORVIUS_BUSINESS_NAME=Summit HVAC
# Owner cell for SMS alerts — NOT the Twilio line
ORVIUS_OWNER_PHONE=+1YOUR_CELL_NUMBER
ORVIUS_OWNER_EMAIL=
ORVIUS_ADMIN_KEY=

# Auth — Google sign-in (https://console.cloud.google.com/apis/credentials)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: comma-separated allowlist (empty = any Google account)
ORVIUS_AUTH_ALLOWED_EMAILS=

# Local/preview only — set to 1 to show "Continue as builder" on /login
# Hard-blocked when NODE_ENV or VERCEL_ENV is production.
# ORVIUS_DEV_AUTH_BYPASS=1
# Optional override email (defaults to ORVIUS_OWNER_EMAIL or first allowlist email)
# ORVIUS_DEV_AUTH_EMAIL=

ORVIUS_FOUNDER_PHONE=

# Optional: owner email backup (Resend)
RESEND_API_KEY=
RESEND_FROM=Orvius <alerts@orvius.im>

# Cron + delivery callbacks
CRON_SECRET=
TWILIO_STATUS_CALLBACK_URL=https://api.orvius.im/api/webhooks/twilio/status

# Optional: notify owners via SMS when a lead is captured
ENABLE_OWNER_SMS=true

# Stripe — run npm run stripe:setup to create Line, Pro, Fleet (monthly + annual)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_LINE=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_FLEET=
STRIPE_PRICE_ID_LINE_ANNUAL=
STRIPE_PRICE_ID_PRO_ANNUAL=
STRIPE_PRICE_ID_FLEET_ANNUAL=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
