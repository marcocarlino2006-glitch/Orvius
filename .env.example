DATABASE_URL="file:./dev.db"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Domain strategy (set after you buy a domain)
ORVIUS_PRIMARY_DOMAIN=orvius.com
ORVIUS_MARKETING_DOMAIN=orvius.com
ORVIUS_APP_DOMAIN=app.orvius.com
ORVIUS_API_DOMAIN=api.orvius.com
ORVIUS_DEPLOY_TARGET=vercel

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Vapi
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# Optional: auto-onboard defaults
ORVIUS_BUSINESS_NAME=Summit HVAC
ORVIUS_OWNER_PHONE=
ORVIUS_OWNER_EMAIL=
ORVIUS_ADMIN_KEY=

# Optional: notify owners via SMS when a lead is captured
ENABLE_OWNER_SMS=true
